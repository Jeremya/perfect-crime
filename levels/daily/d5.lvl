maxPauses: 3
par: 26
map: |
  ########
  #S..#..#
  #...#..#
  #...#..#
  #...#..#
  #...#..#
  #......#
  #...#..#
  #...#L.#
  #...#..#
  #...#.E#
  ########
guards:
