# Medium 10 — "Changing Lights", signature-lite: a crossing of two patrols
# under a rotating camera; thread the shared cell on the tick the camera
# looks away and both cones are open. 3 guards + 1 camera, type stays normal.
# Target par 20-22.
name: "Changing Lights"
type: normal
moment: "Thread the crossing on the exact tick the camera looks away and both patrols are clear of the shared cell."
maxPauses: 3
par: 22
map: |
  ########
  #S.....#
  #......#
  #......#
  #..##..#
  #..##..#
  #......#
  #..L...#
  #......#
  #......#
  #.....E#
  ########
guards:
  - id: g1
    route: [[1,6],[2,6],[3,6],[4,6],[5,6]]
    mode: pingpong
    phase: 0
    range: 2
  - id: g2
