# Hard heist 3 — "Triple Cross", test: three patrols pairwise crossing (every pair
# shares a cell); thread the knot on the tick all cones are open. 3 guards + 1 camera.
name: "Triple Cross"
type: normal
moment: ""
maxPauses: 3
par: 29
map: |
  ########
  #S....E#
  #......#
  #......#
  #..#...#
  #..#...#
  #......#
  #......#
  #......#
  #......#
  #.....L#
  ########
guards:
  - id: g1
    route: [[1,6],[2,6],[3,6],[4,6],[5,6]]
    mode: pingpong
    phase: 0
    range: 2
  - id: g2
    route: [[5,3],[5,4],[5,5],[5,6]]
    mode: pingpong
    phase: 2
    range: 2
  - id: g3
    route: [[4,5],[5,5],[5,6],[4,6]]
    mode: loop
    phase: 1
    range: 2
cameras:
  - id: c1
    at: [3,4]
    dirs: [E, W]
    hold: 12
    phase: 0
    range: 2
