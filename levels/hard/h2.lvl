# Hard heist 2 — "Blind Crossing", practice: camera + laser on the same gap;
# sync the camera away window with the laser off beat. 3 guards + 1 camera + 1 laser.
name: "Blind Crossing"
type: normal
moment: ""
maxPauses: 3
par: 30
map: |
  ########
  #S....L#
  #......#
  #......#
  #......#
  #.######
  #......#
  #......#
  ######.#
  #......#
  #.....E#
  ########
guards:
  - id: g1
    route: [[2,7],[3,7],[4,7]]
    mode: pingpong
    phase: 1
    range: 2
  - id: g2
    route: [[2,10],[3,10],[4,10]]
    mode: pingpong
    phase: 2
    range: 2
  - id: g3
    route: [[2,3],[3,3],[4,3]]
    mode: pingpong
    phase: 0
    range: 2
cameras:
  - id: c1
    at: [0,5]
    dirs: [E, S]
    hold: 6
    phase: 0
    range: 3
lasers:
  - id: l1
    cells: [[1,5]]
    on: 4
    off: 8
    phase: 0
