{
  "name": "@yapcorp/perfect-crime",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "author": "Yap Corp",
  "description": "Perfect Crime — daily heist web prototype (Gate 1). Deterministic grid stealth: draw a plan, press PLAY.",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tools/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "validate": "tsx tools/validate.ts"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
